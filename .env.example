# ── Credentials (required) ────────────────────────────────────────────────────
API_KEY=your_alpaca_api_key_here
SECRET_KEY=your_alpaca_secret_key_here

# ── Trading mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true          # set to false for live trading

# ── Strategy ──────────────────────────────────────────────────────────────────
USE_MACD=true               # use MACD crossover direction
USE_RSI=false               # require RSI confirmation (both must agree when true)
USE_EMA_FILTER=true         # only trade in the direction of the EMA(20) trend

# ── Risk management ───────────────────────────────────────────────────────────
RISK_PER_TRADE=0.02         # fraction of equity risked per trade (2%)
ATR_MULTIPLIER=2.0          # stop-loss width as a multiple of ATR(14)
DYNAMIC_POSITION_SIZING=true
ALLOW_SHORT=true            # true = a SELL from flat opens a short; false = exit-only
MAX_POSITION_PCT=0.25       # hard cap on position notional as a fraction of equity
ORDER_FILL_TIMEOUT=10       # seconds to wait for a market order to fill

# ── Data ──────────────────────────────────────────────────────────────────────
LOOKBACK_MINUTES=300        # historical bars fetched per polling cycle
WARMUP_BARS=50              # bars required before streaming mode trades
DATA_FEED=iex               # iex (free tier) or sip (Algo Trader Plus)
BACKFILL_INTERVAL=60        # seconds between REST backfills that repair feed gaps

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
